{
  "name": "agent-tool-limitation",
  "version": "0.2.0",
  "description": "Agent 工具与参数限制插件（自带可视化配置 UI，支持工具白名单与敏感文件黑名单防护）",
  "icon": "./icon.svg",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./plugin.config.json": "./plugin.config.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "cordis.patch.yml",
    "plugin.config.json",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  }
}
